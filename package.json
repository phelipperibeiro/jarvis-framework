{
  "name": "jarvis-ai-framework",
  "version": "2.1.0",
  "description": "Jarvis framework",
  "type": "module",
  "bin": {
    "jarvis": "./bin/jarvis.js"
  },
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "prepublishOnly": "echo 'Publishing jarvis-framework...'",
    "publish:gitlab": "npm publish",
    "test:comandos": "node test/test-comandos-docs.js",
    "test:filtro": "node --test test/profile-filter.test.js test/token-report.test.js"
  },
  "files": [
