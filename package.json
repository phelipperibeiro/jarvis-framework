{
  "name": "jarvis-ai-framework",
  "version": "2.1.1",
  "description": "Jarvis framework",
  "type": "module",
  "bin": {
    "jarvis": "./bin/jarvis.js"
  },
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "prepublishOnly": "echo 'Publishing jarvis-framework...'",
    "publish:gitlab": "npm publish",
    "test:comandos": "node test/comandos-docs.test.js",
    "test:filtro": "node --test test/profile-filter.test.js test/token-report.test.js test/flow-map.test.js test/env-loader.test.js test/sync-engine.test.js test/vcs-api.test.js",
    "lint": "eslint bin/ test/",
    "lint:fix": "eslint bin/ test/ --fix",
    "format": "prettier --write bin/ test/",
    "format:check": "prettier --check bin/ test/"
  },
  "files": [
    "bin/",
    "agents/",
    "skills/",
    "workflows/",
    "templates/",
    "rules/",
    "rules-on-demand/",
    "taxonomy.md",
    "members.md",
    "AGENTS.md",
    "README.md"
  ],
  "keywords": [
    "ai-prompts",
    "agents",
    "workflows",
    "claude",
    "windsurf",
    "cursor",
    "mcp"
  ],
  "author": "Felipe Ribeiro de Andrade",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phelipperibeiro/jarvis-framework.git"
  },
  "homepage": "https://github.com/phelipperibeiro/jarvis-framework",
  "bugs": {
    "url": "https://github.com/phelipperibeiro/jarvis-framework/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "commander": "^13.1.0"
  }
}
